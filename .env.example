# ==========================================
# News Automation - Environment Configuration
# ==========================================
# Salin file ini menjadi `.env` lalu sesuaikan dengan nilai kredensial Anda.
# Perhatian: JANGAN PERNAH menyimpan token riil ke dalam file template ini atau version control!

# --- Telegram Bot Configuration ---
# Token bot Telegram yang diperoleh dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID percakapan, grup, atau channel penerima siaran
# Contoh format ID grup/channel publik: @channelname, atau ID privat: -1001234567890
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Google Gemini AI Configuration ---
# API key Google Gemini untuk sintesis ringkasan berita berbasis LLM (model gemini-3.8-flash)
# Dapatkan melalui Google AI Studio: https://aistudio.google.com/
# Jika dikosongkan, script akan otomatis menggunakan Local NLP Synthesizer sebagai fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Digest & Output File Paths ---
# Path direktori output untuk arsip berkas digest harian (default: ./digests)
OUTPUT_DIR=./digests

# Path berkas ringkasan harian terkini (default: ./daily-summary.md)
LATEST_SUMMARY_FILE=./daily-summary.md
